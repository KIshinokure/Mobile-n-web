===== mysqldump =====
$ mysqldump -u root --databases mysql > '/mnt/c/Users/doza/Documents/Mobile-n-web/lab4/dumps/mysql-full.sql'

$ mysqldump -u root mysql db > '/mnt/c/Users/doza/Documents/Mobile-n-web/lab4/dumps/mysql-db.sql'

$ mysqldump -u root mysql global_priv user > '/mnt/c/Users/doza/Documents/Mobile-n-web/lab4/dumps/mysql-1.sql'

$ mysqldump -u root -d mysql > '/mnt/c/Users/doza/Documents/Mobile-n-web/lab4/dumps/mysql-schema-only.sql'

$ mysqldump -u root -t mysql > '/mnt/c/Users/doza/Documents/Mobile-n-web/lab4/dumps/mysql-data-only.sql'

$ mysqldump -u root -c -t mysql db > '/mnt/c/Users/doza/Documents/Mobile-n-web/lab4/dumps/mysql-db-complete-insert.sql'

$ mysqldump -u root library > '/mnt/c/Users/doza/Documents/Mobile-n-web/lab4/dumps/library.sql'

